* {
    bg-col: #1e1e2e;
    bg-col-light: #1e1e2e;
    border-col: #1e1e2e;
    selected-col: #1e1e2e;
    blue: #89b4fa;
    fg-col: #cdd6f4;
    fg-col2: #f38ba8;
    grey: #6c7086;
    width: 850;
    font: "JetBrainsMono Nerd Font, Noto Color Emoji 14";
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color: inherit;
}

window {
    height: 440;
    border: 3;
    border-color: @border-col;
    background-color: @bg-col;
}

mainbox {
    background-color: @bg-col;
    padding: 10;
}

inputbar {
    children: [prompt,entry];
    background-color: @bg-col;
    border-radius: 5;
    padding: 5;
    margin: 20 0 0 20;
}

prompt {
    background-color: @blue;
    padding: 10;
    text-color: @bg-col;
    border-radius: 3;
    margin: 0 15 0 0;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 10;
    text-color: @fg-col;
    background-color: @bg-col;
}

listview {
    border: 0;
    padding: 10 10 10 10;
    margin: 15 0 0 20;
    columns: 2;
    lines: 6;
    background-color: @bg-col;
    spacing: 8;
    dynamic: true;
    scrollbar: true;
}

element {
    padding: 8;
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 5;
}

element-icon {
    size: 24;
    padding: 0 10 0 0;
}

element selected {
    background-color: @selected-col;
    text-color: @fg-col2;
    border: 2;
    border-color: @blue;
    border-radius: 5;
}

mode-switcher {
    spacing: 0;
    margin: 10 20 0 0;
}

button {
    padding: 10;
    background-color: @bg-col-light;
    text-color: @grey;
    vertical-align: 0.5;
    horizontal-align: 0.5;
    border-radius: 5;
}

button selected {
    background-color: @bg-col;
    text-color: @blue;
    border: 2;
    border-color: @blue;
    margin: 4;
}

message {
    background-color: @bg-col-light;
    margin: 5;
    padding: 5;
    border-radius: 5;
}

textbox {
    padding: 10;
    margin: 20 0 0 20;
    text-color: @blue;
    background-color: @bg-col-light;
    border-radius: 5;
}
