Operation = Remove\
Type = Package\
Target = *\
\
[Action]\
Description = Criando snapshot antes da opera√ß√£o do pacman...\
When = PreTransaction\
Depends = snapper\
Exec = /usr/bin/snapper --no-dbus -c root create --cleanup-algorithm=number --description="pacman pre-transaction"\
EOF\
\
# Criar hook para limpeza ap√≥s transa√ß√µes\
sudo tee /etc/pacman.d/hooks/99-snapper-post.hook << 'EOF'\
[Trigger]\
Operation = Upgrade\
Operation = Install  \
Operation = Remove\
Type = Package\
Target = *\
\
[Action]\
Description = Limpando snapshots antigos...\
When = PostTransaction\
Depends = snapper\
Exec = /usr/bin/snapper --no-dbus -c root cleanup number\
EOF
