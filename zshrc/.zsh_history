# ================================
# CONFIGURA√Éß√É£O TMUX ERGON√É¥MICA
# Otimizada para Neovim + Hyprland
# ================================
# --- CONFIGURA√Éß√ÉµES B√ÅSICAS ---
# Terminal com suporte completo a cores (crucial para Neovim)
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-256color:RGB"
set -as terminal-overrides ',*:Setulc=\E[58::2::%p1%{65536}%/%d::%p1%{256}%/%{255}%&%d::%p1%{255}%&%d%;m'
# Prefix ergon√¥mico - C-Space evita conflitos com Hyprland (que usa Super)
unbind C-b
set -g prefix C-Space
bind C-Space send-prefix
# Recarregar configura√ß√£o
unbind r
bind r source-file ~/.tmux.conf \; display "Config reloaded\
\
# --- OTIMIZA√Éß√ÉµES DE PERFORMANCE ---\
# ESC delay zero (essencial para Neovim modal editing)\
set -sg escape-time 0\
# Buffer de hist√≥rico generoso\
set -g history-limit 50000\
# Foco em eventos (Neovim autoread)\
set -g focus-events on\
# Status bar responsivo\
set -g status-interval 2\
\
# --- MOUSE INTELIGENTE ---\
# Habilitado mas n√£o intrusivo\
set -g mouse on\
# N√£o sair do copy mode ao selecionar\
unbind -T copy-mode-vi MouseDragEnd1Pane\
\
# Modo vi para navega√ß√£o (compat√≠vel com Neovim)\
set-window-option -g mode-keys vi\
\
# --- SPLITS INTUITIVOS ---\
# Vertical com 'v' (como no Vim)\
unbind %\
bind v split-window -h -c "#{pane_current_path}"\
\
# Horizontal com 's' (split)\
unbind '"'\
bind s split-window -v -c "#{pane_current_path}"\
\
# Nova janela no diret√≥rio atual\
bind c new-window -c "#{pane_current_path}"\
\
# --- NAVEGA√Éß√É£O SEM CONFLITOS ---\
# Pain√©is: vim-tmux-navigator handles this automatically\
# Apenas garantir que est√ÉÅ habilitado\
is_vim="ps -o state= -o comm= -t '#{pane_tty}' \\
    | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?(view|n?vim?x?)(diff)?$'"\
\
# Integra√ß√£o perfeita Tmux <-> Neovim\
bind-key -n 'C-h' if-shell "$is_vim" 'send-keys C-h' 'select-pane -L'\
bind-key -n 'C-j' if-shell "$is_vim" 'send-keys C-j' 'select-pane -D'\
bind-key -n 'C-k' if-shell "$is_vim" 'send-keys C-k' 'select-pane -U'\
bind-key -n 'C-l' if-shell "$is_vim" 'send-keys C-l' 'select-pane -R'\
\
# Alternativa quando C-l est√ÉÅ ocupado (clear screen)\
bind-key -n 'C-\\' if-shell "$is_vim" 'send-keys C-\\' 'select-pane -l'\
\
# Janelas: Alt+number (n√£o conflita com Hyprland que usa Super+number)\
bind -n M-1 select-window -t 1\
bind -n M-2 select-window -t 2  \
bind -n M-3 select-window -t 3\
bind -n M-4 select-window -t 4\
bind -n M-5 select-window -t 5\
bind -n M-6 select-window -t 6\
bind -n M-7 select-window -t 7\
bind -n M-8 select-window -t 8\
bind -n M-9 select-window -t 9\
\
# Navega√ß√£o r√ÉÅpida entre janelas\
bind -n M-h previous-window\
bind -n M-l next-window\
\
# --- REDIMENSIONAMENTO ERGON√É¥MICO ---\
# Com prefix + Shift + hjkl (repeat habilitado)\
bind -r H resize-pane -L 5\
bind -r J resize-pane -D 5  \
bind -r K resize-pane -U 5\
bind -r L resize-pane -R 5\
\
# Layout cycling com Tab\
bind Tab next-layout\
bind S-Tab previous-layout\
\
# --- COPY MODE INTEGRADO COM SYSTEM CLIPBOARD ---\
# Entrar em copy mode\
bind-key v copy-mode\
\
# Bindings estilo Vim no copy mode\
bind-key -T copy-mode-vi v send-keys -X begin-selection\
bind-key -T copy-mode-vi C-v send-keys -X rectangle-toggle\
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "wl-copy"\
bind-key -T copy-mode-vi Escape send-keys -X cancel\
\
# Colar do clipboard do sistema\
bind-key p run "wl-paste --no-newline | tmux load-buffer - && tmux paste-buffer"\
\
# --- SESS√ÉµES E JANELAS ---\
# Renomear sem prefix (n√£o conflita com Hyprland)\
bind -n M-R command-prompt -I "#S" "rename-session '%%'"\
bind -n M-W command-prompt -I "#W" "rename-window '%%'"\
\
# Criar nova sess√£o\
bind N command-prompt -p "Nova sess√£o:" "new-session -d -s '%%'"\
\
# --- UTILIT√ÅRIOS ERGON√É¥MICOS ---\
# Matar painel/janela com confirma√ß√£o\
bind x confirm-before -p "Kill pane? (y/n)" kill-pane\
bind X confirm-before -p "Kill window? (y/n)" kill-window\
\
# Limpar tela e hist√≥rico\
bind C-l send-keys 'clear' C-m \; clear-history\
\
# Toggle sincroniza√ß√£o de pain√©is\
bind S set-window-option synchronize-panes \; display "Sync #{?synchronize-panes,ON,OFF}"\
\
# Zoom toggle (fullscreen de painel)\
bind f resize-pane -Z\
\
# --- CONFIGURA√Éß√ÉµES VISUAIS MINIMALISTAS ---\
# Status bar no topo (n√£o interfere com prompts)\
set -g status-position top\
set -g status-justify centre\
\
# Cores base (Catppuccin Mocha)\
set -g status-bg '#1e1e2e'\
set -g status-fg '#cdd6f4'\
\
# Esquerda: [sess√£o] janela_atual/total\
set -g status-left-length 40\
set -g status-left '#[fg=#89b4fa,bold][#S] #[fg=#a6e3a1]#I/#[fg=#f9e2af]#{session_windows}'\
\
# Direita: hostname & tempo\
set -g status-right-length 50  \
set -g status-right '#[fg=#f38ba8]#H #[fg=#585b70]| #[fg=#cdd6f4]%H:%M'\
\
# Formato das janelas\
set -g window-status-format ' #[fg=#6c7086]#I#[fg=#bac2de]:#W '\
set -g window-status-current-format ' #[bg=#89b4fa,fg=#1e1e2e,bold] #I:#W '\
\
# Bordas dos pain√©is\
set -g pane-border-style fg=#45475a\
set -g pane-active-border-style fg=#89b4fa,bg=default\
\
# Mensagens\
set -g message-style bg=#313244,fg=#cdd6f4,bold\
set -g message-command-style bg=#313244,fg=#cdd6f4\
\
# Copy mode\
set -g mode-style bg=#585b70,fg=#cdd6f4\
\
# --- NUMERA√Éß√É£O E COMPORTAMENTO ---\
# Come√ßar do 1 (mais ergon√¥mico)\
set -g base-index 1\
set -g pane-base-index 1\
set-window-option -g pane-base-index 1\
\
# Renumerar janelas automaticamente\
set-option -g renumber-windows on\
\
# N√£o renomear janelas automaticamente  \
set-option -g allow-rename off\
\
# --- CONFIGURA√Éß√ÉµES AVAN√ÉßADAS ---\
# Sele√ß√£o de palavras inteligente\
set -g word-separators ' @"=()[]{}:,.'\
set -ag word-separators "'"\
\
# T√≠tulo da janela do terminal\
set -g set-titles on\
set -g set-titles-string "tmux: #S | #W"\
\
# Atividade em outras janelas\
set -g monitor-activity on\
set -g visual-activity off\
\
# --- SUPORTE AVAN√ÉßADO PARA NEOVIM ---\
# Permitir passthrough de escape sequences\
set -g allow-passthrough on\
\
# Suporte a undercurl e cores especiais\
set -as terminal-overrides ',*:Smulx=\E[4::%p1%dm'\
set -as terminal-overrides ',*:Setulc=\E[58::2::%p1%{65536}%/%d::%p1%{256}%/%{255}%&%d::%p1%{255}%&%d%;m'\
\
# --- PLUGINS ---\
set -g @plugin 'tmux-plugins/tpm'\
set -g @plugin 'christoomey/vim-tmux-navigator'\
set -g @plugin 'tmux-plugins/tmux-resurrect'  \
set -g @plugin 'tmux-plugins/tmux-continuum'\
\
# --- CONFIGURA√Éß√É£O DE PERSIST√É™NCIA ---\
# Restaurar conte√∫do dos pain√©is\
set -g @resurrect-capture-pane-contents 'on'\
# Estrat√©gia espec√≠fica para Neovim\
set -g @resurrect-strategy-nvim 'session'\
# Auto-restore na inicializa√ß√£o\
set -g @continuum-restore 'on'\
set -g @continuum-save-interval '15'\
\
# --- INICIALIZAR TPM ---\
# Sempre manter no final do arquivo
